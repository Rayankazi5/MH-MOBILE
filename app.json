{
  "expo": {
    "name": "Insight Navigator",
    "slug": "insight-navigator",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "insight",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.insightnavigator.app"
    },
    "android": {
      "package": "com.insightnavigator.app",
      "adaptiveIcon": {
        "backgroundColor": "#0a0e1a"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
